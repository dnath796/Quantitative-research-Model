flowchart TD
    subgraph inputs["Inputs"]
        MKT["Market inputs<br/>s, k, t, sigma, r/rd, q/rf"]
        CSV["data/portfolio.csv<br/>data/spots_timeseries.csv"]
        QUOTE["Market price<br/>(for implied vol)"]
    end

    VAL["Validation layer<br/>s>0, k>=0, t>=0, sigma>=0, rates finite,<br/>type/style/method strings, integer counts,<br/>seed in [0, 2^63-1], rel_bump in (0,1), tol>0, max_iter>=1<br/>-> invalid-input error naming the parameter"]

    MKT --> VAL
    QUOTE --> VAL
    CSV -->|"rows: equity q / FX rd,rf"| VAL

    VAL --> DISPATCH{"Engine"}

    subgraph analytic["Analytic module"]
        LIMITS{"Degenerate?<br/>t=0 / sigma=0 / k=0"}
        CF["Closed form<br/>d1,d2 -> N via erfc<br/>price + 7 Greeks"]
        INTR["Exact limit<br/>(discounted) intrinsic,<br/>2nd-order Greeks = 0"]
        IV["implied_vol<br/>no-arb bounds -><br/>bracketed Newton + bisection<br/>-> error if max_iter exhausted"]
        LIMITS -->|no| CF
        LIMITS -->|yes| INTR
        CF -.->|"vega, price(sigma)"| IV
    end

    subgraph tree["Binomial module"]
        PARAMS["u, d, p from CRR or JR<br/>reject p outside (0,1)<br/>reject lattice overflow (log-spot > 700)"]
        ROLL["Backward induction<br/>American: max(cont, intrinsic)<br/>keep levels 0..2 for Greeks"]
        RICH["Richardson: average<br/>n and n+1 step prices"]
        PARAMS --> ROLL --> RICH
    end

    subgraph mc["Monte Carlo module"]
        RNG["Seeded RNG<br/>antithetic pairing Z, -Z"]
        GBM["Exact GBM step<br/>S exp((r-q-s^2/2)h + s sqrt(h) Z)"]
        PAY["Payoffs: vanilla, arith Asian,<br/>up-and-out barrier, lookback,<br/>pathwise / CRN-FD delta"]
        CVX["Control variates<br/>fwd control / geometric Asian<br/>(closed form mean)"]
        STAT["Statistics on i.i.d. samples<br/>(pair averages) -> SE, 95% CI"]
        RNG --> GBM --> PAY --> CVX --> STAT
    end

    DISPATCH --> LIMITS
    DISPATCH --> PARAMS
    DISPATCH --> RNG

    CF --> OUT["price / Greeks / MCResult"]
    INTR --> OUT
    IV --> OUT
    RICH --> OUT
    STAT --> OUT

    GOLD["data/golden/golden.json<br/>28 cases, generated by Python<br/>reference (generate_data.py)"]
    OUT -.->|"pinned by"| GOLD
    GOLD --> TESTS["4 test suites<br/>pytest / GoogleTest / cargo test / JUnit"]
